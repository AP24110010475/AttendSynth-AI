# AttendSynth AI Environment Configuration Example
# Copy this file to .env and insert your Google Gemini API key:
# cp .env.example .env

# Google Gemini API Key (Required for AI Academic Insights Assistant)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Generative AI Model Identifier
GEMINI_MODEL=gemini-3.8-flash

# Optional Server Port (Defaults to 8000)
PORT=8000
